<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pd_background">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/white">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_ps_back"
            android:contentDescription="Back"
            app:tint="@color/pd_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="Event Details"
            android:textColor="@color/pd_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Share Action -->
        <ImageButton
            android:id="@+id/btnShareEvent"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_share"
            android:contentDescription="Share Event"
            app:tint="@color/pd_primary" />

        <!-- Report Event Action -->
        <ImageButton
            android:id="@+id/btnReportEvent"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_event_flag"
            android:contentDescription="Report Event"
            app:tint="@color/pd_red_text" />
    </LinearLayout>

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero Poster Image -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="220dp">

                <ImageView
                    android:id="@+id/ivDetailPoster"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_event_poster_placeholder"
                    android:contentDescription="Event Poster" />

                <!-- Category Pill -->
                <TextView
                    android:id="@+id/tvDetailCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:layout_gravity="top|start"
                    android:background="@drawable/bg_status_pill"
                    android:backgroundTint="#F1EBFC"
                    android:textColor="@color/pd_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    tools:text="Vaccination Camp" />

                <!-- Event Status Pill (e.g. CANCELLED / COMPLETED) -->
                <TextView
                    android:id="@+id/tvDetailStatusOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="16dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/bg_status_pill"
                    android:backgroundTint="#FEE2E2"
                    android:textColor="@color/pd_red_text"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="5dp"
                    android:visibility="gone"
                    tools:visibility="visible"
                    tools:text="Cancelled" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp">

                <!-- Title -->
                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/pd_text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="3dp"
                    tools:text="Spring Puppy Socialization &amp; Free Rabies Vaccination Camp" />

                <!-- Fee Badge -->
                <TextView
                    android:id="@+id/tvDetailFee"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_status_pill"
                    android:backgroundTint="#E6F6EE"
                    android:textColor="@color/pd_green_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    tools:text="Free Event" />

                <!-- Organizer & Verification Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/pd_card_stroke"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Organized by"
                                    android:textColor="@color/pd_text_muted"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/tvDetailOrganizerName"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/pd_text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    tools:text="Dr. Sarah Adams, DVM" />
                            </LinearLayout>

                            <!-- Verification Badge -->
                            <LinearLayout
                                android:id="@+id/layoutVerificationBadge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/bg_status_pill"
                                android:backgroundTint="#EEF2FF"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="5dp">

                                <ImageView
                                    android:id="@+id/ivDetailVerifiedIcon"
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_event_verified"
                                    app:tint="#4338CA" />

                                <TextView
                                    android:id="@+id/tvDetailVerifiedStatus"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="4dp"
                                    android:text="Community Organizer"
                                    android:textColor="#4338CA"
                                    android:textSize="11sp"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Contact -->
                        <TextView
                            android:id="@+id/tvDetailOrganizerContact"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/pd_text_secondary"
                            android:textSize="13sp"
                            tools:text="📞 Contact: (555) 019-2834 · info@springfieldvet.com" />

                        <!-- Medical Disclaimer Notice if category is veterinary -->
                        <LinearLayout
                            android:id="@+id/layoutDetailMedicalNotice"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_status_pill"
                            android:backgroundTint="#FFFBEB"
                            android:padding="10dp"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="⚠️ Notice: Community-hosted events are organized by independent users. Always verify the clinic or medical credentials directly before administering treatments to your pet."
                                android:textColor="#B45309"
                                android:textSize="11sp"
                                android:lineSpacingExtra="2dp" />
                        </LinearLayout>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Date, Time & Registration Deadline Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/pd_card_stroke"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_reminder_calendar"
                                app:tint="@color/pd_primary" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDetailDate"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/pd_text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    tools:text="Saturday, November 15, 2026" />

                                <TextView
                                    android:id="@+id/tvDetailTime"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/pd_text_muted"
                                    android:textSize="13sp"
                                    tools:text="10:00 AM – 2:00 PM" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Deadline Row -->
                        <TextView
                            android:id="@+id/tvDetailDeadline"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="@color/pd_amber_text"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            tools:text="⏳ Registration closes on Fri, Nov 14, 2026" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Location & Venue Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/pd_card_stroke"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_event_location"
                                app:tint="@color/pd_primary" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="10dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvDetailVenue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/pd_text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold"
                                    tools:text="Central Veterinary Plaza" />

                                <TextView
                                    android:id="@+id/tvDetailAddress"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/pd_text_muted"
                                    android:textSize="13sp"
                                    tools:text="123 Greenway Road, Springfield" />
                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/btnOpenMap"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:src="@android:drawable/ic_dialog_map"
                                android:contentDescription="Open in Google Maps"
                                app:tint="@color/pd_primary" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Capacity & Seat Availability Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/pd_card_stroke"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Participant Capacity"
                                android:textColor="@color/pd_text_primary"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvDetailSeatsStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/pd_primary"
                                android:textSize="13sp"
                                android:textStyle="bold"
                                tools:text="18 / 30 Registered (12 left)" />
                        </LinearLayout>

                        <ProgressBar
                            android:id="@+id/pbCapacity"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="match_parent"
                            android:layout_height="8dp"
                            android:layout_marginTop="10dp"
                            android:max="100"
                            android:progress="60"
                            android:progressTint="@color/pd_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Description Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/pd_card_stroke"
                    app:strokeWidth="1dp"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="About this Event"
                            android:textColor="@color/pd_text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvDetailDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/pd_text_primary"
                            android:textSize="14sp"
                            android:lineSpacingExtra="3dp"
                            tools:text="Join us for a fun morning at Riverside Dog Park! Licensed volunteer veterinarians will provide complimentary rabies vaccinations and microchip scans for all participating dogs and cats." />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Action Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:paddingVertical="12dp"
        android:orientation="horizontal"
        android:elevation="8dp">

        <!-- Participant Buttons: Register / Cancel -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRegisterNow"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Register Now"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/pd_primary"
            app:cornerRadius="25dp" />

        <!-- Already Registered Container -->
        <LinearLayout
            android:id="@+id/layoutAlreadyRegistered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Registered ✓"
                android:textColor="@color/pd_green_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelMyRegistration"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Cancel Registration"
                android:textColor="@color/pd_red_text" />
        </LinearLayout>

        <!-- Organizer Action Buttons -->
        <LinearLayout
            android:id="@+id/layoutOrganizerActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrganizerViewParticipants"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Participants"
                android:textColor="@color/white"
                app:backgroundTint="@color/pd_primary"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrganizerEdit"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:text="Edit"
                android:textColor="@color/pd_primary"
                app:backgroundTint="#F1EBFC"
                app:cornerRadius="24dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOrganizerCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:text="Cancel"
                android:textColor="@color/pd_red_text" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
