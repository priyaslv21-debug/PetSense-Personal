<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pd_background">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/white">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_ps_back"
            android:contentDescription="Back"
            app:tint="@color/pd_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:text="My Events"
            android:textColor="@color/pd_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHeaderCreate"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Host"
            android:textColor="@color/pd_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Tab Layout -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayoutMyEvents"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/white"
        app:tabIndicatorColor="@color/pd_primary"
        app:tabIndicatorHeight="3dp"
        app:tabSelectedTextColor="@color/pd_primary"
        app:tabTextColor="@color/pd_text_secondary"
        app:tabTextAppearance="@style/TextAppearance.MaterialComponents.Subtitle2">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Registered Events" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Events I Created" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshMyEvents"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- Tab 1: Registered Events List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvRegisteredEvents"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="12dp"
                    android:paddingBottom="80dp"
                    android:paddingHorizontal="16dp"
                    android:visibility="visible"
                    tools:listitem="@layout/item_event_registered_card" />

                <!-- Tab 2: Created Events List -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvCreatedEvents"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingTop="12dp"
                    android:paddingBottom="80dp"
                    android:paddingHorizontal="16dp"
                    android:visibility="gone"
                    tools:listitem="@layout/item_event_created_card" />

                <!-- Empty State Registered -->
                <LinearLayout
                    android:id="@+id/layoutEmptyRegistered"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/ic_event_ticket"
                        app:tint="@color/pd_text_tertiary"
                        android:contentDescription="Empty" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="No Registered Events Yet"
                        android:textColor="@color/pd_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Discover vaccination camps, adoption drives, and pet meetups near you!"
                        android:textColor="@color/pd_text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnExploreEvents"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:text="Explore Events"
                        android:textAllCaps="false"
                        app:cornerRadius="12dp"
                        android:backgroundTint="@color/pd_primary" />
                </LinearLayout>

                <!-- Empty State Created -->
                <LinearLayout
                    android:id="@+id/layoutEmptyCreated"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:src="@drawable/ic_event_users"
                        app:tint="@color/pd_text_tertiary"
                        android:contentDescription="Empty" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="No Hosted Events Yet"
                        android:textColor="@color/pd_text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center"
                        android:text="Host your own pet meetup, workshop, or clinic for fellow pet parents in your community."
                        android:textColor="@color/pd_text_secondary"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnEmptyCreateEvent"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginTop="20dp"
                        android:text="Create an Event"
                        android:textAllCaps="false"
                        app:cornerRadius="12dp"
                        android:backgroundTint="@color/pd_primary" />
                </LinearLayout>

                <!-- Loading Spinner -->
                <ProgressBar
                    android:id="@+id/pbLoadingMyEvents"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/pd_primary" />
            </FrameLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Floating Action Button to Host Event -->
        <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
            android:id="@+id/fabHostEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_margin="20dp"
            android:text="Create Event"
            android:textColor="@color/white"
            app:icon="@drawable/ic_ps_add"
            app:iconTint="@color/white"
            android:backgroundTint="@color/pd_primary" />
    </FrameLayout>
</LinearLayout>
