<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/behaviorRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ps_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.behavior.BehaviorActivity">

    <!-- TOP APP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/ps_space_2">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/ps_size_48"
            android:layout_height="@dimen/ps_size_48"
            android:contentDescription="Back"
            app:icon="@drawable/ic_ps_back"
            app:iconTint="@color/ps_text_primary"/>
        <com.google.android.material.textview.MaterialTextView
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="?attr/colorOnSurface"
            android:text="Behavior Analysis"/>
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMore"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="@dimen/ps_size_48"
            android:layout_height="@dimen/ps_size_48"
            android:contentDescription="More options"
            app:icon="@drawable/ic_ps_more_vert"
            app:iconTint="@color/ps_text_primary"/>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/behaviorScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/ps_screen_padding"
            android:paddingTop="@dimen/ps_space_2"
            android:paddingBottom="@dimen/ps_space_4"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- IDLE HEADER: hide when a result is showing -->
                <LinearLayout
                    android:id="@+id/layoutIdleHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvBehaviorMainTitle"
                        android:textAppearance="?attr/textAppearanceHeadlineMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="?attr/colorOnSurface"
                        android:text="Understand Max better"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvBehaviorMainSubtitle"
                        android:textAppearance="?attr/textAppearanceBodyLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ps_space_1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:text="Analyze your pet's behavior using camera or video."/>
                </LinearLayout>

                <!-- PET CONTEXT CARD -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/PS.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ps_space_3">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="@dimen/ps_space_2"
                        android:gravity="center_vertical">
                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/ivPetAvatarContext"
                            android:layout_width="@dimen/ps_size_48"
                            android:layout_height="@dimen/ps_size_48"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_pet_header_placeholder"
                            android:background="@drawable/ps_bg_circle"
                            android:backgroundTint="@color/ps_pastel_lavender"
                            app:shapeAppearanceOverlay="@style/PS.ShapeAppearance.Circle" />
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/ps_space_2">
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvPetContextName"
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="Max"/>
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvPetContextDetails"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="Golden Retriever • 2 Years"/>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- ANALYSIS INPUT CARD / IDLE STATE -->
                <LinearLayout
                    android:id="@+id/layoutInputState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/ps_space_3">

                    <com.google.android.material.card.MaterialCardView
                        style="@style/PS.Card"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ps_size_224">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <androidx.camera.view.PreviewView
                                android:id="@+id/viewFinder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:visibility="gone" />

                            <LinearLayout
                                android:id="@+id/cameraPlaceholder"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:background="@drawable/bg_camera_placeholder">
                                <com.google.android.material.imageview.ShapeableImageView
                                    android:layout_width="@dimen/ps_size_48"
                                    android:layout_height="@dimen/ps_size_48"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_ps_camera_outline"
                                    app:tint="@color/ps_primary_soft"/>
                                <com.google.android.material.textview.MaterialTextView
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ps_space_2"
                                    android:textColor="?attr/colorOnSurfaceVariant"
                                    android:text="Camera Preview"/>
                            </LinearLayout>
                        </FrameLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStartCamera"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ps_size_56"
                        android:layout_marginTop="@dimen/ps_space_2"
                        android:text="Start Camera Analysis"
                        app:backgroundTint="@color/ps_primary"
                        android:textColor="@color/ps_surface"
                        app:icon="@drawable/ic_ps_camera_outline"
                        app:iconGravity="textStart"
                        app:iconTint="@color/ps_surface"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadVideo"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ps_size_56"
                        android:layout_marginTop="@dimen/ps_space_2"
                        android:text="Upload Video"
                        app:strokeColor="@color/ps_outline"
                        android:textColor="@color/ps_text_primary"
                        app:icon="@drawable/ic_ps_video_upload"
                        app:iconGravity="textStart"
                        app:iconTint="@color/ps_primary"/>
                </LinearLayout>

                <!-- ANALYSIS PROGRESS STATE -->
                <LinearLayout
                    android:id="@+id/layoutProgressState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/ps_space_6"
                    android:layout_marginBottom="@dimen/ps_space_6"
                    android:visibility="gone">
                    <com.google.android.material.progressindicator.CircularProgressIndicator
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:indeterminate="true"
                        app:indicatorSize="@dimen/ps_size_64"
                        app:indicatorColor="@color/ps_primary"/>
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/tvProgressTitle"
                        android:textAppearance="?attr/textAppearanceTitleLarge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ps_space_3"
                        android:textColor="?attr/colorOnSurface"
                        tools:text="Analyzing Max..."/>
                    <com.google.android.material.textview.MaterialTextView
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ps_space_1"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:text="Detecting movement and behavior..."/>
                </LinearLayout>

                <!-- BEHAVIOR RESULT STATE -->
                <LinearLayout
                    android:id="@+id/layoutResultState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/ps_space_3"
                    android:visibility="gone">

                    <!-- HERO CARD: predicted mood -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardMoodHero"
                        style="@style/Widget.Material3.CardView.Filled"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardBackgroundColor="?attr/colorSecondaryContainer"
                        app:cardCornerRadius="@dimen/ps_corner_xl"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center_horizontal"
                            android:paddingHorizontal="@dimen/ps_space_3"
                            android:paddingTop="@dimen/ps_space_5"
                            android:paddingBottom="@dimen/ps_space_5">

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvMoodOverline"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="CURRENT MOOD"
                                android:textAppearance="?attr/textAppearanceLabelMedium"
                                android:textColor="?attr/colorOnSecondaryContainer"/>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvResultEmoji"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ps_space_3"
                                android:importantForAccessibility="no"
                                android:includeFontPadding="false"
                                android:textAppearance="?attr/textAppearanceDisplayLarge"
                                tools:text="😌"/>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvResultBehavior"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ps_space_2"
                                android:gravity="center"
                                android:textAppearance="?attr/textAppearanceDisplaySmall"
                                android:textColor="?attr/colorOnSecondaryContainer"
                                android:textStyle="bold"
                                tools:text="Calm"/>

                            <com.google.android.material.chip.Chip
                                android:id="@+id/tvResultConfidence"
                                style="@style/Widget.Material3.Chip.Assist"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ps_space_3"
                                android:clickable="false"
                                android:focusable="false"
                                app:chipBackgroundColor="?attr/colorSurface"
                                app:chipStrokeWidth="0dp"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="86% confident"/>

                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvResultExplanation"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ps_space_3"
                                android:gravity="center"
                                android:textAppearance="?attr/textAppearanceBodyLarge"
                                android:textColor="?attr/colorOnSecondaryContainer"
                                tools:text="Max appears relaxed and is showing low-intensity movement."/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- BEHAVIOR INDICATORS: one outlined container, three columns, dividers between -->
                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cardIndicators"
                        style="@style/Widget.Material3.CardView.Outlined"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ps_space_2">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal">

                            <!-- Motion -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center_horizontal"
                                android:padding="@dimen/ps_space_2">
                                <com.google.android.material.imageview.ShapeableImageView
                                    android:layout_width="@dimen/ps_size_24"
                                    android:layout_height="@dimen/ps_size_24"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_ps_running"
                                    app:tint="@color/ps_primary"/>
                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ps_space_1"
                                    android:text="Motion"
                                    android:textAppearance="?attr/textAppearanceLabelMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant"/>
                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/tvIndicatorMotion"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="Moderate"/>
                            </LinearLayout>

                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="@dimen/ps_divider_thickness"
                                android:layout_height="match_parent"
                                android:layout_marginVertical="@dimen/ps_space_2"/>

                            <!-- Posture -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center_horizontal"
                                android:padding="@dimen/ps_space_2">
                                <com.google.android.material.imageview.ShapeableImageView
                                    android:layout_width="@dimen/ps_size_24"
                                    android:layout_height="@dimen/ps_size_24"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_ps_resting"
                                    app:tint="@color/ps_primary"/>
                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ps_space_1"
                                    android:text="Posture"
                                    android:textAppearance="?attr/textAppearanceLabelMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant"/>
                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/tvIndicatorPosture"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="Relaxed"/>
                            </LinearLayout>

                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="@dimen/ps_divider_thickness"
                                android:layout_height="match_parent"
                                android:layout_marginVertical="@dimen/ps_space_2"/>

                            <!-- Energy -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center_horizontal"
                                android:padding="@dimen/ps_space_2">
                                <com.google.android.material.imageview.ShapeableImageView
                                    android:layout_width="@dimen/ps_size_24"
                                    android:layout_height="@dimen/ps_size_24"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_ps_activity"
                                    app:tint="@color/ps_primary"/>
                                <com.google.android.material.textview.MaterialTextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ps_space_1"
                                    android:text="Energy"
                                    android:textAppearance="?attr/textAppearanceLabelMedium"
                                    android:textColor="?attr/colorOnSurfaceVariant"/>
                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/tvIndicatorEnergy"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:textColor="?attr/colorOnSurface"
                                    tools:text="Moderate"/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- AI INSIGHT CARD -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/PS.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ps_space_2">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/ps_space_2">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical">
                                <com.google.android.material.imageview.ShapeableImageView
                                    android:layout_width="@dimen/ps_size_24"
                                    android:layout_height="@dimen/ps_size_24"
                                    android:importantForAccessibility="no"
                                    android:src="@drawable/ic_ps_insights"
                                    app:tint="@color/ps_pastel_lavender_on"/>
                                <com.google.android.material.textview.MaterialTextView
                                    android:textAppearance="?attr/textAppearanceLabelLarge"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/ps_space_1"
                                    android:textColor="@color/ps_pastel_lavender_on"
                                    android:text="AI Insight"/>
                            </LinearLayout>
                            <com.google.android.material.textview.MaterialTextView
                                android:id="@+id/tvAiInsight"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ps_space_2"
                                android:textColor="?attr/colorOnSurface"
                                tools:text="Max is showing moderate activity with relaxed posture. The observed behavior is consistent with a calm state."/>

                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ps_space_2"
                                android:layout_marginBottom="@dimen/ps_space_2"/>

                            <com.google.android.material.textview.MaterialTextView
                                android:textAppearance="?attr/textAppearanceBodySmall"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="AI analysis is an observation, not a veterinary diagnosis."
                                android:textColor="?attr/colorOnSurfaceVariant"/>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- SUGGESTED ACTION CARD -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/PS.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ps_space_2"
                        app:cardBackgroundColor="@color/ps_pastel_peach"
                        app:strokeWidth="0dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="@dimen/ps_space_2"
                            android:gravity="center_vertical">
                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="@dimen/ps_size_40"
                                android:layout_height="@dimen/ps_size_40"
                                android:padding="@dimen/ps_space_1"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_ps_paw"
                                android:background="@drawable/ps_bg_circle"
                                android:backgroundTint="@color/ps_surface"
                                app:tint="@color/ps_pastel_peach_on"/>
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:layout_marginStart="@dimen/ps_space_2">
                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/tvActionSuggestionTitle"
                                    android:textAppearance="?attr/textAppearanceTitleSmall"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/ps_pastel_peach_on"
                                    tools:text="Suggested for Max"/>
                                <com.google.android.material.textview.MaterialTextView
                                    android:id="@+id/tvActionSuggestionDesc"
                                    android:textAppearance="?attr/textAppearanceBodyMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/ps_pastel_peach_on"
                                    tools:text="Try a 10–15 minute play session later this evening."/>
                            </LinearLayout>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- START NEW ANALYSIS BUTTON -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetAnalysis"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ps_size_56"
                        android:layout_marginTop="@dimen/ps_space_2"
                        android:text="Start New Analysis"
                        android:textColor="@color/ps_primary"/>
                </LinearLayout>

                <!-- RECENT ANALYSES: section label above, rows grouped in ONE elevated surface -->
                <com.google.android.material.textview.MaterialTextView
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ps_space_4"
                    android:textColor="?attr/colorOnSurface"
                    android:text="Recent Analysis"/>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardRecentAnalyses"
                    style="@style/Widget.Material3.CardView.Elevated"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ps_space_2">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Empty State -->
                        <LinearLayout
                            android:id="@+id/layoutHistoryEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingHorizontal="@dimen/ps_space_3"
                            android:paddingVertical="@dimen/ps_space_4">
                            <com.google.android.material.imageview.ShapeableImageView
                                android:layout_width="@dimen/ps_size_48"
                                android:layout_height="@dimen/ps_size_48"
                                android:importantForAccessibility="no"
                                android:src="@drawable/ic_ps_empty_observations"
                                app:tint="@color/ps_primary_soft"/>
                            <com.google.android.material.textview.MaterialTextView
                                android:textAppearance="?attr/textAppearanceTitleMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ps_space_2"
                                android:textColor="?attr/colorOnSurface"
                                android:text="No behavior analyses yet"/>
                            <com.google.android.material.textview.MaterialTextView
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ps_space_1"
                                android:gravity="center"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                android:text="Complete your first analysis to start building your pet's behavior history."/>
                        </LinearLayout>

                        <!-- Populated History List: rows use item_behavior_analysis.xml -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvRecentAnalyses"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            android:paddingVertical="@dimen/ps_space_1"
                            android:visibility="gone"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </FrameLayout>

    <!-- BOTTOM NAVIGATION -->
    <com.google.android.material.divider.MaterialDivider
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:dividerColor="@color/ps_outline"/>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ps_surface"
        app:elevation="@dimen/ps_space_1"
        app:itemIconTint="@color/ps_bottom_nav_item"
        app:itemTextColor="@color/ps_bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu" />
</LinearLayout>