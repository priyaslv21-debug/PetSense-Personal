<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pd_card_stroke"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Test Name & Status Pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTestName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Alanine Aminotransferase (ALT)"
                    android:textColor="@color/pd_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTestCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Liver Panel"
                    android:textColor="@color/pd_text_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="5dp"
                android:text="HIGH"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/pd_red_text"
                android:background="@drawable/bg_status_pill" />
        </LinearLayout>

        <!-- Value & Reference Range Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="bottom"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvMeasuredValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="135"
                android:textColor="@color/pd_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="2dp"
                android:text="U/L"
                android:textColor="@color/pd_text_secondary"
                android:textSize="14sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvRefRange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="Report Range: 10 - 100 U/L"
                android:textColor="@color/pd_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Expand / Collapse AI Explanation Toggle -->
        <TextView
            android:id="@+id/tvToggleExplanation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="💡 What this means ▼"
            android:textColor="@color/pd_primary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:paddingVertical="4dp" />

        <!-- AI Clinical Explanation Box (Expandable) -->
        <LinearLayout
            android:id="@+id/layoutAiExplanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="#F8F6FD"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <!-- Explanation -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📖 What this represents:"
                android:textColor="@color/pd_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAiExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ALT is an enzyme concentrated in liver cells. Mild elevation can indicate cellular stress, inflammation, or medication response."
                android:textColor="@color/pd_text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <!-- Possible Clinical Significance -->
            <TextView
                android:id="@+id/lblSignificance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🔬 Clinical Significance:"
                android:textColor="#B45309"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvClinicalSignificance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Possible hepatocellular stress, toxic response, or secondary hepatic inflammation."
                android:textColor="@color/pd_text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <!-- Recommended Veterinary Follow-up -->
            <TextView
                android:id="@+id/lblFollowUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="🩺 Recommended Follow-Up:"
                android:textColor="@color/pd_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRecommendedFollowUp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Re-evaluate liver enzymes in 2-4 weeks; assess current medications and supplements with your vet."
                android:textColor="@color/pd_text_primary"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
