<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pd_card_stroke"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header: Lab Name & Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvHistoryLabName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="IDEXX Diagnostics"
                android:textColor="@color/pd_text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHistoryDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nov 2, 2026"
                android:textColor="@color/pd_text_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Pet Info & Species -->
        <TextView
            android:id="@+id/tvHistoryPetInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="🐾 Buster (Canine)"
            android:textColor="@color/pd_primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- File Name & Meta -->
        <TextView
            android:id="@+id/tvHistoryFileName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="📄 blood_panel_nov26.pdf"
            android:textColor="@color/pd_text_secondary"
            android:textSize="13sp" />

        <!-- Status Badges & Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tvHistoryAbnormalBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="2 Abnormal"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/pd_red_text"
                android:background="@drawable/bg_status_pill" />

            <TextView
                android:id="@+id/tvHistoryTotalBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="14 Tests Total"
                android:textSize="12sp"
                android:textColor="@color/pd_text_secondary"
                android:background="@drawable/bg_status_pill" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Share Action -->
            <ImageButton
                android:id="@+id/btnHistoryShare"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_share"
                android:contentDescription="Share Report"
                app:tint="@color/pd_text_secondary" />

            <!-- Delete Action -->
            <ImageButton
                android:id="@+id/btnHistoryDelete"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                android:contentDescription="Delete Report"
                app:tint="@color/pd_red_text" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
