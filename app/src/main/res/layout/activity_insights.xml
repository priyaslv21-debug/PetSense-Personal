<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/insightsRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ps_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.insights.InsightsActivity">

    <!-- TOP APP BAR -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_ps_back"
            android:contentDescription="Back"
            app:tint="@color/ps_text_primary"/>
        <TextView
            style="@style/PS.Text.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Insights"/>
        <ImageButton
            android:id="@+id/btnMore"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_ps_more_vert"
            app:tint="@color/ps_text_primary"/>
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/insightsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="32dp"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- HERO SECTION -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/ps_screen_padding">

                <LinearLayout
                    android:id="@+id/heroTextLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/ivHeroPet"
                    android:layout_marginTop="16dp">
                    <TextView
                        android:id="@+id/tvHeroTitle"
                        style="@style/PS.Text.Display"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="28sp"
                        tools:text="Personalized\ninsights for Max" />
                    <TextView
                        android:id="@+id/tvHeroSubtitle"
                        style="@style/PS.Text.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="Golden Retriever • 2 Years" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivHeroPet"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:src="@drawable/pet_insight"
                    android:scaleType="fitCenter"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- MAIN AI INSIGHT CARD -->
            <com.google.android.material.card.MaterialCardView
                style="@style/PS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ps_screen_padding"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="@color/ps_surface">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:background="@drawable/ps_bg_gradient_subtle">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_ps_sparkle"
                            app:tint="@color/ps_primary"/>
                        <TextView
                            style="@style/PS.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/ps_primary"
                            android:text="AI Insight"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvAiInsightText"
                        style="@style/PS.Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textColor="@color/ps_text_primary"
                        android:lineSpacingMultiplier="1.2"
                        tools:text="Max has been more active this week, with activity increasing during the evening."/>

                    <TextView
                        android:id="@+id/tvAiInsightContext"
                        style="@style/PS.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        tools:text="Based on recent activity, sleep and behavior data."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- THIS WEEK SECTION -->
            <TextView
                style="@style/PS.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ps_screen_padding"
                android:layout_marginTop="28dp"
                android:layout_marginBottom="12dp"
                android:text="Activity Summary"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ps_screen_padding"
                android:columnCount="2"
                android:useDefaultMargins="true">

                <!-- Activity -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/PS.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🐾"
                                android:textSize="18sp"/>
                            <TextView
                                style="@style/PS.Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Activity"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvThisWeekActivityValue"
                            style="@style/PS.Text.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="22sp"
                            android:textColor="@color/ps_primary"
                            tools:text="+12%"/>
                        <TextView
                            android:id="@+id/tvThisWeekActivityDesc"
                            style="@style/PS.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            tools:text="More active"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Sleep -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/PS.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="💤"
                                android:textSize="18sp"/>
                            <TextView
                                style="@style/PS.Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Sleep"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvThisWeekSleepValue"
                            style="@style/PS.Text.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="22sp"
                            android:textColor="@color/ps_pastel_blue_on"
                            tools:text="Stable"/>
                        <TextView
                            android:id="@+id/tvThisWeekSleepDesc"
                            style="@style/PS.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            tools:text="Healthy pattern"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Nutrition -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/PS.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginEnd="6dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🍽"
                                android:textSize="18sp"/>
                            <TextView
                                style="@style/PS.Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Nutrition"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvThisWeekNutritionValue"
                            style="@style/PS.Text.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="22sp"
                            android:textColor="@color/ps_pastel_green_on"
                            tools:text="Normal"/>
                        <TextView
                            android:id="@+id/tvThisWeekNutritionDesc"
                            style="@style/PS.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            tools:text="Good"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Behavior -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/PS.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_columnWeight="1"
                    android:layout_marginStart="6dp"
                    android:layout_marginBottom="12dp"
                    app:cardCornerRadius="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="😊"
                                android:textSize="18sp"/>
                            <TextView
                                style="@style/PS.Text.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:text="Behavior"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvThisWeekBehaviorValue"
                            style="@style/PS.Text.Display"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textSize="22sp"
                            android:textColor="@color/ps_pastel_peach_on"
                            tools:text="Mostly Calm"/>
                        <TextView
                            android:id="@+id/tvThisWeekBehaviorDesc"
                            style="@style/PS.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            tools:text="4 of 7 days"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </GridLayout>

            <!-- ACTIVITY TREND -->
            <TextView
                style="@style/PS.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ps_screen_padding"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:text="Activity Trend"/>

            <com.google.android.material.card.MaterialCardView
                style="@style/PS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ps_screen_padding"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:id="@+id/trendBarsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="bottom"
                        android:orientation="horizontal"
                        android:visibility="gone"/>

                    <TextView
                        android:id="@+id/tvTrendEmpty"
                        style="@style/PS.Text.Caption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="Add more activity records to see your trend."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- PATTERN DETECTED -->
            <TextView
                style="@style/PS.Text.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ps_screen_padding"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="12dp"
                android:text="Behavior Pattern"/>

            <com.google.android.material.card.MaterialCardView
                style="@style/PS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ps_screen_padding"
                app:cardCornerRadius="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvPatternTitle"
                        style="@style/PS.Text.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/ps_text_primary"
                        tools:text="🌙 Evening Activity"/>

                    <TextView
                        android:id="@+id/tvPatternDesc"
                        style="@style/PS.Text.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        tools:text="Max is usually most active between 6 PM and 8 PM."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- RECOMMENDATION CARD -->
            <com.google.android.material.card.MaterialCardView
                style="@style/PS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ps_screen_padding"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="20dp"
                app:cardBackgroundColor="@color/ps_pastel_lavender">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_ps_lightbulb"
                            app:tint="@color/ps_primary"/>
                        <TextView
                            style="@style/PS.Text.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:textColor="@color/ps_primary"
                            android:text="Recommended for Max"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRecommendation"
                        style="@style/PS.Text.Title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="16sp"
                        android:textColor="@color/ps_text_primary"
                        android:lineSpacingMultiplier="1.2"
                        tools:text="Try a short play session around his usual evening activity period."/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===================== PET CARE REMINDERS SECTION ===================== -->
            <LinearLayout
                android:id="@+id/sectionPetCareReminders"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical">

                <!-- SECTION HEADER -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/ps_screen_padding"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/PS.Text.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pet Care Reminders" />

                        <TextView
                            style="@style/PS.Text.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Vaccinations, check-ups &amp; medications" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickAddReminder"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="14dp"
                        android:text="+ Add"
                        android:textColor="@color/ps_primary"
                        android:textSize="13sp"
                        app:backgroundTint="@color/pd_lavender"
                        app:cornerRadius="18dp" />
                </LinearLayout>

                <!-- METRIC SUMMARY TILES (Upcoming, Due Today, Overdue) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/ps_screen_padding"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <!-- Upcoming Tile -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/ps_surface"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/pd_card_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvStatUpcomingCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/ps_primary"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="3" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Upcoming"
                                android:textColor="@color/pd_text_muted"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Due Today Tile -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="4dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/pd_amber_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/pd_amber_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvStatDueTodayCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/pd_amber_text"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="1" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Due Today"
                                android:textColor="@color/pd_amber_text"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Overdue Tile -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_weight="1"
                        app:cardBackgroundColor="@color/pd_red_bg"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:strokeColor="@color/pd_red_stroke"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:id="@+id/tvStatOverdueCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/pd_red_text"
                                android:textSize="22sp"
                                android:textStyle="bold"
                                tools:text="0" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Overdue"
                                android:textColor="@color/pd_red_text"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                </LinearLayout>

                <!-- CATEGORY FILTER CHIPS -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clipToPadding="false"
                    android:paddingHorizontal="@dimen/ps_screen_padding"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupReminderFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterAll"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="All" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterVaccine"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Vaccination" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterCheckup"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Check-up" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterDeworming"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Deworming" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipFilterMedication"
                            style="@style/Widget.Material3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Medication" />

                    </com.google.android.material.chip.ChipGroup>
                </HorizontalScrollView>

                <!-- REMINDERS RECYCLER VIEW -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvReminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never" />

                <!-- EMPTY REMINDERS STATE -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardEmptyReminders"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/ps_screen_padding"
                    android:layout_marginTop="8dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/ps_surface"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/pd_card_stroke"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_reminder_calendar"
                            app:tint="@color/ps_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="No Reminders Scheduled"
                            android:textColor="@color/pd_text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="Schedule vaccinations, vet check-ups, and medications to keep your pet healthy."
                            android:textColor="@color/pd_text_muted"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEmptyScheduleReminder"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:layout_marginTop="16dp"
                            android:text="Schedule First Reminder"
                            android:textColor="@color/ps_primary"
                            android:textSize="13sp"
                            app:backgroundTint="@color/pd_lavender"
                            app:cornerRadius="20dp"
                            app:icon="@drawable/ic_ps_add"
                            app:iconTint="@color/ps_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- PROMINENT ADD REMINDER BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddNewReminder"
                    style="@style/PD.Button.Teal"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginHorizontal="@dimen/ps_screen_padding"
                    android:layout_marginTop="16dp"
                    android:text="Add New Reminder"
                    android:textColor="@android:color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/ps_primary"
                    app:cornerRadius="26dp"
                    app:icon="@drawable/ic_ps_add"
                    app:iconGravity="textStart"
                    app:iconTint="@android:color/white" />

            </LinearLayout>

            <!-- 🔴 NEW: EXPORT PDF BUTTON (Properly placed outside the card) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExportPdf"
                style="@style/PS.Button.Quick"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginHorizontal="@dimen/ps_screen_padding"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                app:cornerRadius="12dp"
                app:iconGravity="textStart"
                android:text="Export Health Report (PDF)" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- BOTTOM NAVIGATION -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ps_outline" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/ps_surface"
        app:elevation="8dp"
        app:itemIconTint="@color/ps_bottom_nav_item"
        app:itemTextColor="@color/ps_bottom_nav_item"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_navigation_menu" />
</LinearLayout>