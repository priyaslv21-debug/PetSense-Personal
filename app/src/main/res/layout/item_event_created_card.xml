<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pd_card_stroke"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Category & Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCreatedCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="#F1EBFC"
                android:textColor="@color/pd_primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                tools:text="Pet Meetup" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvCreatedStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_pill"
                android:backgroundTint="#E6F6EE"
                android:textColor="@color/pd_green_text"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                tools:text="Active" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvCreatedTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/pd_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end"
            tools:text="Spring Community Vaccination &amp; Microchipping Drive" />

        <!-- Date & Location -->
        <TextView
            android:id="@+id/tvCreatedDateTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/pd_text_muted"
            android:textSize="13sp"
            tools:text="📅 Sat, Nov 15, 2026 · 10:00 AM" />

        <TextView
            android:id="@+id/tvCreatedLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/pd_text_muted"
            android:textSize="13sp"
            tools:text="📍 Central Veterinary Plaza, Springfield" />

        <!-- Participant Count Indicator -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="#F8F6FD"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_event_users"
                app:tint="@color/pd_primary" />

            <TextView
                android:id="@+id/tvCreatedParticipantCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textColor="@color/pd_text_primary"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="18 / 50 Registered Participants" />
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelCreatedEvent"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Cancel Event"
                android:textColor="@color/pd_red_text"
                android:textSize="12sp"
                android:paddingHorizontal="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditCreatedEvent"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="Edit"
                android:textColor="@color/pd_primary"
                android:textSize="12sp"
                app:backgroundTint="#F1EBFC"
                app:cornerRadius="18dp"
                android:paddingHorizontal="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewParticipants"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:text="Participants"
                android:textColor="@color/white"
                android:textSize="12sp"
                app:backgroundTint="@color/pd_primary"
                app:cornerRadius="18dp"
                android:paddingHorizontal="14dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
