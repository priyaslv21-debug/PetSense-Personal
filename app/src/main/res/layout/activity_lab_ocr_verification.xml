<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/pd_background">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:background="@color/white">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_ps_back"
            android:contentDescription="Back"
            app:tint="@color/pd_text_primary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Verify Extracted Data"
            android:textColor="@color/pd_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddMissingTest"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ Add Test"
            android:textSize="12sp"
            app:cornerRadius="18dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:strokeColor="@color/pd_primary"
            android:textColor="@color/pd_primary" />
    </LinearLayout>

    <!-- Active Pet Profile Banner -->
    <LinearLayout
        android:id="@+id/layoutPetContext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvVerifyPetEmoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🐕"
            android:textSize="20sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvVerifyPetName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Patient: Luna"
                android:textColor="@color/pd_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvVerifyPetMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Canine · Golden Retriever"
                android:textColor="@color/pd_text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnChangePet"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Change Pet"
            android:textSize="12sp"
            android:textColor="@color/pd_primary" />
    </LinearLayout>

    <!-- Missing Pet Warning Alert Banner -->
    <LinearLayout
        android:id="@+id/layoutNoPetWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FEF2F2"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚠️"
            android:textSize="16sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="No pet selected! Please select a pet before proceeding."
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSelectPetPrompt"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:text="Select Pet"
            android:textSize="11sp"
            app:cornerRadius="17dp"
            android:textColor="#DC2626"
            app:strokeColor="#DC2626" />
    </LinearLayout>

    <!-- Sample Quality Warnings Banner -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSampleQuality"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="#FDE68A"
        app:strokeWidth="1dp"
        app:cardBackgroundColor="#FFFBEB">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧪"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvSampleQualityWarnings"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Sample Quality: Hemolysis detected. Hemolysis may artifactually alter AST and Potassium readings."
                android:textColor="#92400E"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Subtitle Guidance Banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F1EBFC"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔍"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvVerifySubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Review &amp; correct any misread OCR parameters. Missing ranges remain unclassified."
            android:textColor="@color/pd_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Report Metadata Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutLabProvider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:hint="Lab Name"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etLabProvider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Veterinary Diagnostics"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutReportDate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Test Date"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etReportDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:clickable="true"
                android:textSize="13sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Extracted Test Items List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvOcrItems"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="12dp" />

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/layoutEmptyVerification"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:visibility="gone"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📋"
            android:textSize="48sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="No Test Parameters Extracted"
            android:textColor="@color/pd_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Tap '+ Add Test' above to manually enter your pet's test values."
            android:textColor="@color/pd_text_muted"
            android:textSize="13sp"
            android:gravity="center" />
    </LinearLayout>

    <!-- Bottom Action CTA -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:background="@color/white"
        android:elevation="6dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmAndAnalyze"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="Verify &amp; Run Analysis"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="27dp"
            android:backgroundTint="@color/pd_primary" />
    </LinearLayout>
</LinearLayout>
