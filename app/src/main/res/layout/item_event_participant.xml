<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/pd_card_stroke"
    app:strokeWidth="1dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Participant Name & Registration Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvParticipantName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/pd_text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Alex Johnson" />

            <TextView
                android:id="@+id/tvParticipantRegisteredTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/pd_text_muted"
                android:textSize="11sp"
                tools:text="Nov 10, 2:30 PM" />
        </LinearLayout>

        <!-- Contact Information -->
        <TextView
            android:id="@+id/tvParticipantContact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/pd_text_secondary"
            android:textSize="13sp"
            tools:text="📞 (555) 019-2834 · ✉️ alex@example.com" />

        <!-- Pet Demographics Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_status_pill"
            android:backgroundTint="#F8F6FD"
            android:paddingHorizontal="10dp"
            android:paddingVertical="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_ps_paw"
                app:tint="@color/pd_primary" />

            <TextView
                android:id="@+id/tvParticipantPet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textColor="@color/pd_text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="Pet: Buster (Canine · 3 yrs)" />
        </LinearLayout>

        <!-- Optional Notes -->
        <TextView
            android:id="@+id/tvParticipantNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/pd_text_muted"
            android:textSize="12sp"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="Notes: Needs quiet space; slightly nervous around large crowds." />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
