rules_version = '2';

// ===============================================================
// PetSense Security Rules for Cloud Firestore (petsense-personal)
// ===============================================================
//
// 1. users/{userId} (and all subcollections: pets, reminders, lab_records, registered_events, etc.)
//    - Private owner-only access: request.auth.uid == userId
//
// 2. events/{eventId}
//    - Read: Authenticated users can discover events
//    - Create: Authenticated users setting themselves as organizer
//    - Update: Organizer can edit details (organizerId is immutable); attendees can update registrationCount in transaction
//    - Delete: Only the organizer can delete their event
//
// 3. events/{eventId}/registrations/{userId}
//    - Read: Registrant or the event organizer
//    - Create/Update: Only the registrant (request.auth.uid == userId)
//    - Delete: Registrant or the event organizer
//
// 4. event_reports/{reportId}
//    - Create: Authenticated users with reporterId == request.auth.uid
//    - Read/Update/Delete: Denied for client SDKs (moderation only)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isEventOrganizer(eventId) {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/events/$(eventId)) &&
             get(/databases/$(database)/documents/events/$(eventId)).data.organizerId == request.auth.uid;
    }

    // ===============================================================
    // User Profiles & Private Subcollections
    // ===============================================================
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ===============================================================
    // Community & Events
    // ===============================================================
    match /events/{eventId} {
      // Authenticated users can discover events
      allow read: if isAuthenticated();

      // Authenticated users can create an event; must set themselves as organizer
      allow create: if isAuthenticated() &&
                    request.resource.data.organizerId == request.auth.uid &&
                    request.resource.data.title is string &&
                    request.resource.data.title.size() > 0;

      // Event updates:
      // 1. Organizer can edit their event (organizerId cannot be transferred)
      // 2. Attendees can update registrationCount (and optional updatedAt) via transactions
      allow update: if isAuthenticated() && (
        (resource.data.organizerId == request.auth.uid &&
         request.resource.data.organizerId == resource.data.organizerId) ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registrationCount', 'updatedAt']) &&
         request.resource.data.get('registrationCount', 0) is number &&
         request.resource.data.registrationCount >= 0)
      );

      // Only the event organizer can delete an event
      allow delete: if isAuthenticated() && resource.data.organizerId == request.auth.uid;

      // Event registrations subcollection
      match /registrations/{userId} {
        // Read: Registrant or the event organizer
        allow read: if isAuthenticated() && (
          request.auth.uid == userId ||
          isEventOrganizer(eventId)
        );

        // Create / Update: Only the registrant can register themselves
        allow create, update: if isOwner(userId) &&
                              (!('userId' in request.resource.data) || request.resource.data.userId == userId);

        // Delete: Registrant or the event organizer
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          isEventOrganizer(eventId)
        );
      }
    }

    // ===============================================================
    // Moderation & Reports
    // ===============================================================
    match /event_reports/{reportId} {
      allow create: if isAuthenticated() && (
        request.resource.data.get('reporterId', '') == request.auth.uid ||
        request.resource.data.get('reportedByUserId', '') == request.auth.uid
      );

      allow read, update, delete: if false;
    }
  }
}
